# Markdown is private by default (internal notes, plans, research); only the
# published documentation is tracked: the README, the three guides at the
# repository root, and the sources of the documentation website.
/**/*.md
!/README.md
!/ECS.md
!/ENGINE_API.md
!/WASM.md
!/website/**/*.md
