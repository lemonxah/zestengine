# {{name}} dedicated server image (generated by Build Game). Built from the prebuilt binary:
#   cd <the build-server folder>
#   docker build -f deploy/Dockerfile -t {{slug}}:latest .
# The binary is dynamically linked against glibc: BASE must carry a glibc at least as new as the
# machine that built it (debian:stable-slim usually does). For a static image build with
# ZESTENGINE_SERVER_TARGET=x86_64-unknown-linux-musl and use BASE=gcr.io/distroless/static-debian12:nonroot
# (then drop the useradd line and `USER` to 65532).
ARG BASE=debian:stable-slim
FROM ${BASE}

RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin {{slug}} \
 && mkdir -p {{state_dir}} {{log_dir}} \
 && chown -R 10001:10001 {{state_dir}} {{log_dir}}

WORKDIR {{install_dir}}
COPY --chown=0:0 zestengine-server {{install_dir}}/zestengine-server
COPY --chown=0:0 assets {{install_dir}}/assets
COPY --chown=0:0 deploy/server.ron {{install_dir}}/server.ron

USER 10001:10001
# Identity, bans and saved world: keep this volume across upgrades.
VOLUME {{state_dir}}
# Game port, signed admin port (publish it to operators only). The LAN discovery port is not exposed.
EXPOSE {{game_port}}/udp {{admin_port}}/udp

# Reads the heartbeat file under state_dir: no network, no keys. start-period covers the first scene load.
HEALTHCHECK --interval=15s --timeout=3s --start-period=60s --retries=3 \
  CMD ["{{install_dir}}/zestengine-server", "--healthcheck", "--config", "{{install_dir}}/server.ron"]

# SIGTERM (docker stop) is graceful. Exit code 75 (`restart`) is honoured by restart: unless-stopped.
STOPSIGNAL SIGTERM
ENTRYPOINT ["{{install_dir}}/zestengine-server", "--config", "{{install_dir}}/server.ron", "--no-console"]
