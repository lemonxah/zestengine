# {{name}} with docker compose (generated by Build Game). From the build-server folder:
#   docker compose -f deploy/docker-compose.yml up -d --build
# Needs deploy/{{slug}}.env (copy {{slug}}.env.example).
name: {{slug}}
services:
  {{slug}}:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
    image: {{slug}}:latest
    restart: unless-stopped        # also restarts after the `restart` admin command (exit code 75)
    stop_grace_period: 10s
    env_file: {{slug}}.env
    ports:
      - "{{game_port}}:{{game_port}}/udp"
      # Admin port: bind it to an operator-only address (a VPN IP or loopback), never 0.0.0.0.
      # Uncomment together with admin_port and admin_keys in server.ron.
      # - "127.0.0.1:{{admin_port}}:{{admin_port}}/udp"
    volumes:
      - state:{{state_dir}}       # identity.key, bans.ron, world.state*, players.state*
    read_only: true
    tmpfs:
      - /tmp
      - {{log_dir}}:uid=10001,gid=10001
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    ulimits:
      nofile: { soft: 65536, hard: 65536 }
    # cpuset: "2,3"
    # healthcheck: inherited from the Dockerfile (zestengine-server --healthcheck)
volumes:
  state:
