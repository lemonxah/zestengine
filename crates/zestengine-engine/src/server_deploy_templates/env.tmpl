# Secrets of {{name}} (generated by Build Game). Install as /etc/{{slug}}/{{slug}}.env, mode 0600,
# owner root. Read by systemd (EnvironmentFile) or docker compose (env_file).
# Join password (empty = open server). Keeps it out of `ps` and out of server.ron.
ZESTENGINE_SERVER_PASSWORD=
# Operator token, only when the relay you open rooms on requires one.
ZESTENGINE_RELAY_TOKEN=
# Verbose logging for one session: RUST_LOG is not used, set log_level in server.ron instead.
