#!/bin/sh
# {{name}}: install on a systemd host (generated by Build Game). Run from the build-server folder as root:
#   sudo deploy/install.sh
# It does NOT enable or start the service and does not touch the firewall.
set -eu
here="$(cd "$(dirname "$0")/.." && pwd)"
id -u {{slug}} >/dev/null 2>&1 || useradd --system --user-group --no-create-home --shell /usr/sbin/nologin {{slug}}
mkdir -p {{install_dir}} /etc/{{slug}}
# The binary and the cooked assets. NOT the state folder: that is {{state_dir}} and survives upgrades.
cp -f "$here/zestengine-server" {{install_dir}}/zestengine-server
rm -rf {{install_dir}}/assets.new && cp -r "$here/assets" {{install_dir}}/assets.new
rm -rf {{install_dir}}/assets.old
[ -d {{install_dir}}/assets ] && mv {{install_dir}}/assets {{install_dir}}/assets.old
mv {{install_dir}}/assets.new {{install_dir}}/assets
cp -rf "$here/deploy" {{install_dir}}/deploy
chmod 755 {{install_dir}}/zestengine-server
# Config: never overwrite one the operator edited.
[ -f /etc/{{slug}}/server.ron ] || cp "$here/deploy/server.ron" /etc/{{slug}}/server.ron
[ -f /etc/{{slug}}/{{slug}}.env ] || { install -m 0600 "$here/deploy/{{slug}}.env.example" /etc/{{slug}}/{{slug}}.env; }
install -m 0644 "$here/deploy/{{slug}}.service" /etc/systemd/system/{{slug}}.service
install -m 0644 "$here/deploy/{{slug}}@.service" /etc/systemd/system/{{slug}}@.service
systemctl daemon-reload
echo "installed. Edit /etc/{{slug}}/server.ron and /etc/{{slug}}/{{slug}}.env, then:"
echo "  systemctl enable --now {{slug}}"
