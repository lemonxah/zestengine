// {{name}}: settings of ONE instance of {{slug}}@.service (generated by Build Game).
// Copy to /etc/{{slug}}/<instance>.ron and give every instance its own numbers (N = 0, 1, 2 ...):
//   port        = {{game_port}} + 10*N
//   admin_port  = port + 1
//   state_dir   = /var/lib/{{slug}}/<instance>      (the unit's StateDirectory={{slug}}/%i)
//   metrics_addr = 127.0.0.1:(9100 + N), when used
(
    project: "{{install_dir}}/assets",
{{scene_line}}    port: {{game_port}},
    server_name: "{{name}} <instance>",
    max_players: 16,
    log_path: "{{log_dir}}/<instance>.log",
    lan_discovery: false,
    console: false,
    state_dir: "/var/lib/{{slug}}/<instance>",
    // admin_port: {{admin_port}},
    // admin_keys: [(name: "ops", key: "PUT_THE_64_HEX_DIGIT_PUBLIC_KEY_HERE", role: Admin)],
    // metrics_addr: "127.0.0.1:9100",
)
