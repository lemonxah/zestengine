# {{name}} on Kubernetes (generated by Build Game): PVC + Deployment + UDP Service.
# Build and push the image first (deploy/Dockerfile), then:
#   kubectl apply -f deploy/kubernetes.yaml
# Secrets (server password, relay token) live in a Secret, never in this file:
#   kubectl create secret generic {{slug}}-env --from-literal=ZESTENGINE_SERVER_PASSWORD=... [--from-literal=ZESTENGINE_RELAY_TOKEN=...]
# One replica only: the saved world, bans and the pinned server identity live in one volume.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{slug}}-state
  labels: { app: {{slug}} }
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      storage: 1Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{slug}}
  labels: { app: {{slug}} }
spec:
  replicas: 1
  strategy:
    type: Recreate          # never two servers on one state volume
  selector:
    matchLabels: { app: {{slug}} }
  template:
    metadata:
      labels: { app: {{slug}} }
    spec:
      terminationGracePeriodSeconds: 15   # SIGTERM saves the world and sends the shutdown redirect
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
      containers:
        - name: server
          image: {{slug}}:latest          # replace with your registry path
          imagePullPolicy: IfNotPresent
          ports:
            - { name: game, containerPort: {{game_port}}, protocol: UDP }
            # The signed admin port is deliberately NOT in the Service; use `kubectl port-forward`
            # or a separate internal Service when admin_port is enabled in server.ron.
          envFrom:
            - secretRef: { name: {{slug}}-env, optional: true }
          volumeMounts:
            - { name: state, mountPath: {{state_dir}} }
            - { name: logs, mountPath: {{log_dir}} }
            - { name: tmp, mountPath: /tmp }
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: { drop: ["ALL"] }
          resources:
            requests: { cpu: "500m", memory: "512Mi" }
            limits: { memory: "2Gi" }
          startupProbe:
            exec:
              command: ["{{install_dir}}/zestengine-server", "--healthcheck", "--config", "{{install_dir}}/server.ron"]
            periodSeconds: 5
            failureThreshold: 24
          livenessProbe:
            exec:
              command: ["{{install_dir}}/zestengine-server", "--healthcheck", "--config", "{{install_dir}}/server.ron"]
            periodSeconds: 15
            timeoutSeconds: 3
            failureThreshold: 3
      volumes:
        - name: state
          persistentVolumeClaim: { claimName: {{slug}}-state }
        - name: logs
          emptyDir: {}
        - name: tmp
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: {{slug}}
  labels: { app: {{slug}} }
spec:
  # LoadBalancer needs a provider with UDP support; use NodePort (and open that port) elsewhere.
  type: LoadBalancer
  externalTrafficPolicy: Local        # keep the player's real address (bans, rate limits)
  selector: { app: {{slug}} }
  ports:
    - { name: game, port: {{game_port}}, targetPort: game, protocol: UDP }
