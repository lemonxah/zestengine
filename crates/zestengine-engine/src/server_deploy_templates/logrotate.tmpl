# {{name}}: logrotate example (generated by Build Game). Install as /etc/logrotate.d/{{slug}}.
# The server already rotates {{log_dir}}/server.log by size (log_max_mb x log_keep in server.ron);
# this adds daily rotation + compression of the rotated files. copytruncate because the server
# keeps the file open; with it, set log_max_mb high (e.g. 500) so the two do not both rotate.
{{log_dir}}/*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su {{slug}} {{slug}}
}
