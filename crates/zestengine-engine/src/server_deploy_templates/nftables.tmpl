# {{name}}: nftables example (generated by Build Game). Merge into your ruleset, do not load blindly
# over a running firewall (`nft -c -f` checks the syntax). Replace OPS_NET with your operators'
# addresses (a VPN range, an office IP).
define OPS_NET = { 203.0.113.0/24 }

table inet {{slug}} {
    chain input {
        type filter hook input priority 0; policy accept;
        # Players.
        udp dport {{game_port}} accept
        # Signed admin commands: operators only (the signature is the second lock).
        udp dport {{admin_port}} ip saddr $OPS_NET accept
        udp dport {{admin_port}} drop
        # LAN discovery stays closed on a public host; a relay (UDP 47800) only if you run one here.
        udp dport 47777 drop
        # udp dport 47800 accept
        # Cheap flood limit on the game port (tune to your player count).
        # udp dport {{game_port}} limit rate over 20000/second drop
    }
}
