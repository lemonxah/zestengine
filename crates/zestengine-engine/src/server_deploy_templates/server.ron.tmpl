// {{name}}: production settings (generated by Build Game, Dedicated server).
// Installed as /etc/{{slug}}/server.ron (systemd) or {{install_dir}}/server.ron (container).
// Secrets do not belong here: set ZESTENGINE_SERVER_PASSWORD and ZESTENGINE_RELAY_TOKEN in
// /etc/{{slug}}/{{slug}}.env (mode 0600). See docs/deployment/dedicated-server.md.
(
    // The cooked assets of this build.
    project: "{{install_dir}}/assets",
{{scene_line}}    port: {{game_port}},
    tick_rate: 30.0,
    max_players: 16,
    server_name: "{{name}}",
    log_path: "{{log_dir}}/server.log",
    log_level: "info",
    log_max_mb: 50,
    log_keep: 5,
    // Players on the internet find the server by address or the directory, not by LAN broadcast.
    lan_discovery: false,
    console: false,

    // The ONE folder that must persist: identity.key (the pinned server identity), bans.ron,
    // world.state*, players.state*, and the health.status / metrics.prom heartbeat. It must live
    // OUTSIDE the build folder: a rebuild or a re-upload of the build folder would wipe it.
    // Back this folder up; one folder per instance.
    state_dir: "{{state_dir}}",
    persist: true,
    persist_interval: 60.0,
    persist_keep: 3,

    // Heartbeat for `zestengine-server --healthcheck` (0 turns it off).
    health_interval: 5.0,
    // Optional Prometheus / health endpoint, loopback only, off by default:
    // metrics_addr: "127.0.0.1:9100",

    // Signed remote admin. Make a key on YOUR machine: `zestengine-admin keygen`, paste the public
    // key here, keep the secret key off the server. Firewall the admin UDP port to operators only.
    // Roles: Observer, Moderator, Admin. Rotate: add the new key, `reload`, test it, remove the old key, `reload`.
    // admin_port: {{admin_port}},
    // admin_bind: "0.0.0.0",
    // admin_keys: [
    //     (name: "ops-alice", key: "PUT_THE_64_HEX_DIGIT_PUBLIC_KEY_HERE", role: Admin),
    //     (name: "mod-bob",   key: "PUT_THE_64_HEX_DIGIT_PUBLIC_KEY_HERE", role: Moderator),
    // ],

    // Public server list (a relay run with --directory), and a region tag for it.
    // directory: "relay.example.com:47800",
    // region: "eu",
    // Where players are sent during an upgrade (the `shutdown <addr>` command can name one per stop).
    // shutdown_redirect: "",
)
