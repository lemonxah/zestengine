# {{name}} dedicated servers, several instances per host (generated by Build Game).
#
# One instance per config file:  systemctl enable --now {{slug}}@arena1   reads /etc/{{slug}}/arena1.ron
# and keeps its state in /var/lib/{{slug}}/arena1. Write each instance's own state_dir, port and
# admin_port into its .ron (see instance.ron.example): one state_dir + game port + admin port per
# instance, never shared.
#
# Port allocation rule: instance number N (0, 1, 2 ...) takes game UDP {{game_port}} + 10*N and admin
# UDP game + 1 (so {{game_port}}/{{admin_port}}, {{game_port_1}}/{{admin_port_1}}, ...); the loopback metrics
# port, when used, is 9100 + N. Only one instance should answer LAN discovery (UDP 47777): set
# `lan_discovery: false` in the others (all of them in production).
[Unit]
Description={{name}} dedicated server instance %i (ZestEngine)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User={{slug}}
Group={{slug}}
WorkingDirectory={{install_dir}}
ExecStart={{install_dir}}/zestengine-server --config /etc/{{slug}}/%i.ron --no-console
EnvironmentFile=-/etc/{{slug}}/{{slug}}.env
EnvironmentFile=-/etc/{{slug}}/%i.env

Restart=on-failure
RestartForceExitStatus=75
SuccessExitStatus=0
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10

# /var/lib/{{slug}}/%i : must equal `state_dir` in /etc/{{slug}}/%i.ron.
StateDirectory={{slug}}/%i
StateDirectoryMode=0700
LogsDirectory={{slug}}
LogsDirectoryMode=0750
UMask=0077

LimitNOFILE=65536
# Give each instance its own cores: edit with `systemctl edit {{slug}}@arena1`.
#CPUAffinity=2 3
#Nice=-5

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
