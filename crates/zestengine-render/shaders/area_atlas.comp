#version 450
// Sample rather than blit: BC/sRGB sources decode through their image view,
// and render-texture sources need no transfer-source usage or layout change.
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D source_image;
layout(set=0,binding=1,rgba16f) uniform writeonly image2D atlas;
layout(push_constant) uniform Params { uvec2 origin; } pc;
void main() {
    uvec2 p=gl_GlobalInvocationID.xy;
    if(any(greaterThanEqual(p,uvec2(256)))) return;
    vec2 uv=(vec2(p)+0.5)/256.0;
    vec2 size=vec2(textureSize(source_image,0));
    float lod=max(log2(max(size.x,size.y)/256.0),0.0);
    imageStore(atlas,ivec2(pc.origin+p),textureLod(source_image,uv,lod));
}
