#version 450
// Full-resolution diffuse history, separate for every view. Radiance history
// is reprojected only onto matching world surfaces; it is never fed into the
// world-space surface cache or used as a running maximum of brightness.
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D current_gi;
layout(set=0,binding=1) uniform sampler2D depth_image;
layout(set=0,binding=2) uniform sampler2D previous_gi;
layout(set=0,binding=3) uniform sampler2D previous_geometry;
layout(set=0,binding=4,rgba16f) uniform writeonly image2D output_gi;
layout(set=0,binding=5,rgba16f) uniform writeonly image2D output_geometry;
// ScreenGiParams prefix; the matrices exactly match this view's depth pass,
// including TAA jitter and Vulkan viewport orientation.
struct GiProbeVolume { mat4 world_to_local; vec4 size_base; vec4 counts; };
layout(set=0,binding=6) uniform Params {
    mat4 inv_view_proj; mat4 prev_view_proj;
    vec4 cam; vec4 prev_cam; vec4 gdf_min; vec4 gdf_max; vec4 sky;
    uvec4 counts; vec4 march; uvec4 misc;
    vec4 probe_info; GiProbeVolume volumes[4]; vec4 temporal;
} pc;
vec3 world_at(ivec2 pixel,float depth,ivec2 size) {
    vec2 ndc=(vec2(pixel)+0.5)/vec2(size)*2.0-1.0;
    if (pc.misc.w!=0u) ndc.y=-ndc.y;
    vec4 p=pc.inv_view_proj*vec4(ndc,depth,1.0);
    return p.xyz/p.w;
}
void main() {
    ivec2 px=ivec2(gl_GlobalInvocationID.xy),size=imageSize(output_gi);
    if (any(greaterThanEqual(px,size))) return;
    vec3 current=max(texelFetch(current_gi,px,0).rgb,vec3(0.0));
    float depth=texelFetch(depth_image,px,0).r;
    if (depth>=1.0) {
        imageStore(output_gi,px,vec4(current,0.0));
        imageStore(output_geometry,px,vec4(0.0)); return;
    }
    vec3 P=world_at(px,depth,size);
    ivec2 pl=max(px-ivec2(1,0),ivec2(0)),pr=min(px+ivec2(1,0),size-1);
    ivec2 pd=max(px-ivec2(0,1),ivec2(0)),pu=min(px+ivec2(0,1),size-1);
    float dl=texelFetch(depth_image,pl,0).r,dr=texelFetch(depth_image,pr,0).r;
    float dd=texelFetch(depth_image,pd,0).r,du=texelFetch(depth_image,pu,0).r;
    vec3 dx=(px.x==0 || (px.x<size.x-1 && abs(dr-depth)<abs(dl-depth))) ? world_at(pr,dr,size)-P : P-world_at(pl,dl,size);
    vec3 dy=(px.y==0 || (px.y<size.y-1 && abs(du-depth)<abs(dd-depth))) ? world_at(pu,du,size)-P : P-world_at(pd,dd,size);
    vec3 N=cross(dx,dy);
    if (dot(N,N)<1e-12) {
        imageStore(output_gi,px,vec4(current,1.0)); imageStore(output_geometry,px,vec4(0.0)); return;
    }
    N=normalize(N); if (dot(N,pc.cam.xyz-P)<0.0) N=-N;
    float footprint=max(length(dx),length(dy));
    vec3 history=vec3(0.0); float frames=0.0,weights=0.0;
    vec4 clip=pc.prev_view_proj*vec4(P,1.0);
    if (pc.march.z<0.999 && clip.w>0.0) {
        vec2 uv=clip.xy/clip.w;
        if (pc.misc.w!=0u) uv.y=-uv.y;
        vec2 q=(uv*0.5+0.5)*vec2(size)-0.5;
        ivec2 base=ivec2(floor(q)); vec2 f=fract(q);
        float distance=length(P-pc.prev_cam.xyz);
        for (int i=0;i<4;++i) {
            ivec2 off=ivec2(i&1,i>>1),at=base+off;
            if (any(lessThan(at,ivec2(0))) || any(greaterThanEqual(at,size))) continue;
            vec4 geometry=texelFetch(previous_geometry,at,0);
            if (geometry.w<=0.0 || dot(geometry.xyz,N)<0.9) continue;
            // Include fp16 distance precision as well as a pixel footprint.
            float tolerance=max(max(0.015,footprint*1.5),distance*0.001);
            if (abs(geometry.w-distance)>tolerance) continue;
            vec4 h=texelFetch(previous_gi,at,0);
            if (h.a<1.0) continue;
            vec2 w=mix(1.0-f,f,vec2(off)); float weight=w.x*w.y;
            history+=h.rgb*weight; frames+=h.a*weight; weights+=weight;
        }
    }
    float count=1.0;
    if (weights>0.05) {
        history/=weights; frames/=weights;
        // A same-surface neighbourhood bounds stale lighting after a source or
        // occluder changes. The variance band admits Monte Carlo fluctuations
        // instead of treating every dark sample as proof that history is wrong.
        vec3 mean=vec3(0.0),second=vec3(0.0); float total=0.0;
        for (int y=-1;y<=1;++y) for (int x=-1;x<=1;++x) {
            ivec2 at=clamp(px+ivec2(x,y),ivec2(0),size-1);
            float z=texelFetch(depth_image,at,0).r;
            if (z>=1.0) continue;
            vec3 p=world_at(at,z,size);
            if (abs(dot(p-P,N))>max(0.01,footprint*0.75)) continue;
            vec3 c=max(texelFetch(current_gi,at,0).rgb,vec3(0.0));
            mean+=c; second+=c*c; total+=1.0;
        }
        mean/=max(total,1.0); second/=max(total,1.0);
        vec3 sigma=sqrt(max(second-mean*mean,vec3(0.0)));
        vec3 radius=max(3.0*sigma,mean*0.25+0.002);
        history=clamp(history,max(mean-radius,vec3(0.0)),mean+radius);
        count=min(frames+1.0,max(pc.temporal.y,1.0));
        float alpha=max(1.0/count,clamp(pc.temporal.z,0.0,1.0));
        current=mix(history,current,alpha);
    }
    imageStore(output_gi,px,vec4(current,count));
    imageStore(output_geometry,px,vec4(N,min(length(P-pc.cam.xyz),65000.0)));
}
