#version 450
#define SURFACE_BINDING 1
#define SURFACE_NODE_COUNT surface_tree_info.w
#define SURFACE_MULTIBOUNCE true
#include "flux_surface.glsl"
layout(local_size_x=1) in;
layout(set=0,binding=0) writeonly buffer Results { vec4 results[]; };
layout(set=0,binding=9) readonly buffer Queries { vec4 queries[]; };
#define MESH_SDF_BINDING 10
#define MESH_SDF_NODE_COUNT queries[0].w
#define MESH_ALPHA_FRAME 0u
#include "flux_mesh_sdf.glsl"
void main() {
    uint i=gl_GlobalInvocationID.x;
    vec3 origin=vec3(0.3,-0.045,0.3),direction=normalize(queries[i].xyz-origin);
    float t;uint who;
    bool hit=mesh_sdf_trace(origin,direction,100.0,t,who);
    vec3 p=hit ? origin+direction*t : queries[i].xyz;
    vec3 n=mesh_sdf_normal(2u,p);
    results[i]=vec4(hit ? t : -1.0,p.y,n.y,surface_mesh_opacity(p,n,2u));
    if(!hit) {
        MeshSdfInstance m=mesh_sdfs[2];float a,b;
        mesh_sdf_box(origin,direction,m.geometry_lo.xyz-0.002,m.geometry_hi.xyz+0.002,100.0,a,b);
        results[i]=vec4(-1.0,mesh_sdf_sample(m,origin+direction*a),mesh_sdf_sample(m,origin+direction*b),b-a);
    }
}
