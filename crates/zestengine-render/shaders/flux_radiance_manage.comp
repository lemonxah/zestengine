#version 460
layout(local_size_x=64) in;
#define RC_BINDING 0
#include "flux_radiance_cache.glsl"
layout(push_constant) uniform Phase {uint phase;} push;
uint priority(uint index) {
    uvec4 s=rc_probes[index].state;
    if(s.z==0u || s.z+1u<rc_config.x) return 32u;
    if(s.x!=rc_config.y || s.w==0u || s.w!=rc_trace_resolution(index) || rc_probes[index].reactive.y>s.y) return 0u;
    uint age=rc_config.x-s.y;
    // Newly exposed probes stay first. Aging requested probes eventually outrank
    // continuous animation, so a video surface cannot monopolize all updates.
    if(age>=32u) return 1u;
    if(rc_probes[index].reactive.x>s.y) return age<2u ? 32u : 2u+8u-min(age,8u);
    return age<4u ? 32u : 1u+31u-min(age,31u);
}
void main() {
    uint index=gl_GlobalInvocationID.x;
    if(push.phase==1u) {
        if(index!=0u) return;
        uint left=rc_config.z*4u,cutoff=32u;
        for(uint b=0u;b<32u;++b) {
            uint count=rc_work[16u+b];if(count>=left) {cutoff=b;break;}left-=count;
        }
        rc_work[1]=1u;rc_work[2]=1u;rc_work[6]=cutoff;rc_work[7]=left;return;
    }
    if(index>=RC_PROBES) return;
    if(push.phase==0u) {
        int level=int(index/4096u);uint slot=index%4096u;
        ivec3 wrapped=ivec3(slot%16u,(slot/16u)%16u,slot/256u);
        ivec3 low=rc_origin[level].xyz;
        ivec3 cell=low+ivec3((uvec3(wrapped-low))&uvec3(15u));
        if(any(notEqual(rc_probes[index].cell,ivec4(cell,level)))) {
            rc_probes[index].cell=ivec4(cell,level);rc_probes[index].state=uvec4(0);rc_probes[index].reactive=uvec4(0);
        }
        vec3 p=rc_position(cell,level);
        // A probe can see changed surfaces anywhere along its finite trace:
        // that range, with its local-sphere offset and a cell footprint, is
        // the conservative limit. Within it a change matters to the probe
        // only as far as its reach (flux_changes.rs). Every ray leaves the
        // probe radially, so the stored directions are those of its centre:
        // what a moved body covers of them, how far changed light carries.
        float limit=uintBitsToFloat(rc_reactive.z)+rc_spacing[level]*rc_spacing.w*2.0;
        for(uint i=0u;i<rc_reactive.x;++i) {
            vec4 lo=rc_regions[i*2u],hi=rc_regions[i*2u+1u];
            vec3 delta=max(max(lo.xyz-p,p-hi.xyz),vec3(0));
            float distance2=dot(delta,delta),reach=abs(hi.w);
            // Out to four reaches the change still fills a directional texel
            // or delivers a sixteenth of what it does at its reach: refresh
            // soon, reusing the stored rays meanwhile.
            float refresh=min(4.0*reach,limit);
            if(distance2>refresh*refresh) continue;
            rc_probes[index].reactive.x=rc_config.x;
            // Within the reach of moved geometry previously unoccluded light
            // cannot be reused. Keep storage/resolution, but reject it until
            // freshly traced.
            float reject=min(reach,limit);
            if(lo.w>0.0 && distance2<=reject*reject) {rc_probes[index].reactive.y=rc_config.x;break;}
        }
        uint bucket=priority(index);if(bucket<32u) atomicAdd(rc_work[16u+bucket],rc_trace_cost(index));
    } else {
        uint bucket=priority(index),cutoff=rc_work[6];
        if(bucket>=32u || bucket>cutoff) return;
        uint cost=rc_trace_cost(index);
        if(bucket==cutoff && atomicAdd(rc_work[8],cost)+cost>rc_work[7]) return;
        uint slot=atomicAdd(rc_work[0],1u);
        if(slot<RC_MAX_UPDATES) rc_work[RC_QUEUE_START+slot]=index;
        if((rc_config.w&2u)!=0u) {
            atomicAdd(rc_work[9],cost*64u);
            atomicAdd(rc_work[cost==1u ? 10u : 11u],1u);
        }
    }
}
