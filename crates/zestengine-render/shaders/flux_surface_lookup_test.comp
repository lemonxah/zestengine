#version 450
#define SURFACE_BINDING 1
#define SURFACE_NODE_COUNT surface_tree_info.w
#define SURFACE_MULTIBOUNCE true
#include "flux_surface.glsl"
layout(local_size_x=1) in;
layout(set=0,binding=0) writeonly buffer Results { vec4 results[]; };
layout(set=0,binding=9) readonly buffer Queries { vec4 queries[]; };
void main() {
    uint i=gl_GlobalInvocationID.x;
    uint start=uint(queries[i].w);
    SurfaceSample hit=surface_lookup_range(queries[i].xyz,vec3(0,0,1),0.02,start,start+2u);
    bool valid=false;vec3 light=surface_radiance(hit,valid);
    results[i]=hit.valid ? vec4(float(hit.card),float(surface_cards[hit.card].virtual_page.y),light.r,valid ? 1.0 : 0.0) : vec4(-1);
}
