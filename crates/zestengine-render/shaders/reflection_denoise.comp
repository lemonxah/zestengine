#version 450
// Reconstruct only the signed reflection replacement term. Direct lighting,
// diffuse GI, exposure and bloom never enter the reflection history.
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D raw_reflection;
layout(set=0,binding=1) uniform sampler2D scene_color;
layout(set=0,binding=2) uniform sampler2D scene_depth;
layout(set=0,binding=3) uniform sampler2D scene_gbuffer;
layout(set=0,binding=4) uniform sampler2D previous_color;
layout(set=0,binding=5) uniform sampler2D previous_geometry;
layout(set=0,binding=6,rgba16f) uniform writeonly image2D result;
layout(set=0,binding=7,rgba16f) uniform writeonly image2D history_color;
layout(set=0,binding=8,rgba32f) uniform writeonly image2D history_geometry;
layout(set=0,binding=9) uniform Params {
    mat4 inverse_view_projection;
    mat4 inverse_view;
    mat4 previous_view_projection;
    mat4 previous_inverse_view_projection;
    vec4 camera;
    vec4 options; // history valid, enabled, max history frames, relative plane tolerance
} pc;
vec3 oct_decode(vec2 e) {
    e=e*2.0-1.0;vec3 n=vec3(e,1.0-abs(e.x)-abs(e.y));
    float t=max(-n.z,0.0);n.xy+=mix(vec2(t),vec2(-t),greaterThanEqual(n.xy,vec2(0)));
    return normalize(n);
}
vec2 oct_encode(vec3 n) {
    n/=abs(n.x)+abs(n.y)+abs(n.z);
    vec2 e=n.z>=0.0 ? n.xy : (1.0-abs(n.yx))*mix(vec2(-1),vec2(1),greaterThanEqual(n.xy,vec2(0)));
    return e*0.5+0.5;
}
vec2 material(vec4 g) {
    uint b=uint(round(g.b*1023.0)),a=uint(round(g.a*3.0));
    return vec2(float(b>>4),float((b&15u)|(a<<4)))/63.0;
}
vec3 normal(ivec2 p) {return normalize(mat3(pc.inverse_view)*oct_decode(texelFetch(scene_gbuffer,p,0).rg));}
vec3 position(vec2 uv,float d,mat4 inverse_vp) {
    vec4 p=inverse_vp*vec4(uv.x*2.0-1.0,1.0-uv.y*2.0,d,1);return p.xyz/p.w;
}
vec3 to_ycocg(vec3 c) {return vec3(dot(c,vec3(0.25,0.5,0.25)),(c.r-c.b)*0.5,(-c.r+2.0*c.g-c.b)*0.25);}
vec3 to_rgb(vec3 c) {return vec3(c.x+c.y-c.z,c.x+c.z,c.x-c.y-c.z);}
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy),size=imageSize(result);
    if(any(greaterThanEqual(p,size))) return;
    vec4 raw=texelFetch(raw_reflection,p,0);float depth=texelFetch(scene_depth,p,0).r;
    vec2 rr=material(texelFetch(scene_gbuffer,p,0));vec2 uv=(vec2(p)+0.5)/vec2(size);
    vec3 base=texelFetch(scene_color,p,0).rgb;
    if(raw.a<0.0 || depth>=0.9999) {
        imageStore(result,p,vec4(base,1));imageStore(history_color,p,vec4(0));imageStore(history_geometry,p,vec4(1,0,0,0));return;
    }
    vec3 n=normal(p),world=position(uv,depth,pc.inverse_view_projection);
    vec3 current=raw.rgb,mean=to_ycocg(current),second=mean*mean;
    vec3 lower=mean,upper=mean;float weight=1.0;
    bool filtering=pc.options.y>0.5 && rr.x>0.08;
    if(filtering) {
        // Small geometry/material-aware kernel; mirrors bypass it completely.
        for(int y=-1;y<=1;++y) for(int x=-1;x<=1;++x) {
            if(x==0 && y==0) continue;
            ivec2 q=p+ivec2(x,y);if(any(lessThan(q,ivec2(0))) || any(greaterThanEqual(q,size))) continue;
            vec4 sample_value=texelFetch(raw_reflection,q,0);if(sample_value.a<0.0) continue;
            float d=texelFetch(scene_depth,q,0).r;if(d>=0.9999) continue;
            vec2 m=material(texelFetch(scene_gbuffer,q,0));vec3 nn=normal(q);
            if(abs(m.x-rr.x)>0.04 || abs(m.y-rr.y)>0.04 || dot(n,nn)<0.97) continue;
            vec3 np=position((vec2(q)+0.5)/vec2(size),d,pc.inverse_view_projection);
            if(abs(dot(np-world,n))>max(0.005,length(world-pc.camera.xyz)*0.001)) continue;
            float w=exp(-float(x*x+y*y)*0.7);vec3 c=to_ycocg(sample_value.rgb);
            mean+=c*w;second+=c*c*w;weight+=w;lower=min(lower,c);upper=max(upper,c);
        }
        mean/=weight;second/=weight;
        current=mix(raw.rgb,to_rgb(mean),smoothstep(0.08,0.3,rr.x));
    }
    float frames=1.0;
    if(filtering && pc.options.x>0.5) {
        // Glossy lobes reproject the virtual reflected hit; broad lobes use
        // receiver motion. This accounts for reflection parallax on translation.
        float virtual_weight=1.0-smoothstep(0.15,0.5,rr.x);
        vec3 virtual_position=world-normalize(pc.camera.xyz-world)*raw.a*virtual_weight;
        vec4 clip=pc.previous_view_projection*vec4(virtual_position,1);
        vec3 projected=clip.xyz/clip.w;vec2 puv=vec2(projected.x*0.5+0.5,0.5-projected.y*0.5);
        if(clip.w>0.0 && projected.z>=0.0 && projected.z<1.0 && all(greaterThanEqual(puv,vec2(0))) && all(lessThan(puv,vec2(1)))) {
            vec2 pixel=puv*vec2(size)-0.5;ivec2 first=ivec2(floor(pixel));vec2 fraction=fract(pixel);
            vec3 color=vec3(0);float total=0.0,count=0.0;
            for(int corner=0;corner<4;++corner) {
                ivec2 offset=ivec2(corner&1,corner>>1),q=first+offset;
                if(any(lessThan(q,ivec2(0))) || any(greaterThanEqual(q,size))) continue;
                vec4 meta=texelFetch(previous_geometry,q,0);uint packed=uint(round(meta.w));uint old_count=packed>>12;
                if(old_count==0u || meta.x>=0.9999) continue;
                vec2 old_rr=vec2(float((packed>>6)&63u),float(packed&63u))/63.0;
                if(abs(old_rr.x-rr.x)>0.04 || abs(old_rr.y-rr.y)>0.04 || dot(n,oct_decode(meta.yz))<0.97) continue;
                vec3 old_world=position((vec2(q)+0.5)/vec2(size),meta.x,pc.previous_inverse_view_projection);
                if(abs(dot(old_world-world,n))>max(0.005,length(world-pc.camera.xyz)*pc.options.w)) continue;
                vec2 weights=mix(vec2(1)-fraction,fraction,vec2(offset));float w=weights.x*weights.y;
                vec4 old_color=texelFetch(previous_color,q,0);
                if(abs(old_color.a-raw.a)>max(0.1,0.3*max(old_color.a,raw.a))) continue;
                color+=old_color.rgb*w;count+=float(old_count)*w;total+=w;
            }
            if(total>0.25) {
                vec3 sigma=sqrt(max(second-mean*mean,vec3(0)));
                vec3 old=clamp(to_ycocg(color/total),max(lower,mean-2.0*sigma),min(upper,mean+2.0*sigma));
                float max_frames=mix(2.0,pc.options.z,smoothstep(0.08,0.5,rr.x));
                frames=min(count/total+1.0,max_frames);current=mix(to_rgb(old),current,1.0/frames);
            }
        }
    }
    uint packed=(uint(round(frames))<<12)|(uint(round(rr.x*63.0))<<6)|uint(round(rr.y*63.0));
    imageStore(history_color,p,vec4(current,raw.a));imageStore(history_geometry,p,vec4(depth,oct_encode(n),float(packed)));
    imageStore(result,p,vec4(base+current,1));
}
