// GPU-only world-reflection work scheduling. One bounded job per receiver;
// FP32 partial lighting and packed FP16 world weights, with deterministic ray
// directions regenerated by the same function as the inline reference path.
// Header is also VkDispatchIndirectCommand; all counts stay on the GPU.
layout(set=0,binding=25,std430) buffer ReflectionQueue {
    uint dispatch_x;uint dispatch_y;uint dispatch_z;uint job_count;
    uint words[];
} work;
uint reflection_job_stride() {return 5u+(clamp(uint(u.quality.x+0.5),1u,16u)+1u)/2u;}

#ifdef REFLECTION_QUEUE_SCREEN
shared uint pending[64];
shared uint group_base;
void main() {
    ivec2 px=ivec2(gl_GlobalInvocationID.xy);
    uint lane=gl_LocalInvocationIndex;
    bool inside=all(lessThan(px,ivec2(u.screen.xy)));
    if(inside) {
        int owner=reflection_owner(px);
        if(owner>=0 && owner!=((px.x&1)+2*(px.y&1))) {
            imageStore(u_out,px,vec4(0,0,0,-2-owner));inside=false;
        }
    }
    ReflectionReceiver r;
    vec4 sum=vec4(0);uint weights[8];for(int i=0;i<8;++i) weights[i]=0u;
    bool unresolved=false;
    if(inside && reflection_receiver(px,r)) {
        for(int k=0;k<r.samples;++k) {
            float distance;vec4 hit=reflection_screen_sample(r,reflection_direction(px,r,k),distance);
            // Quantize only the unresolved fraction. The screen fraction is its
            // exact complement, so the two stages preserve unit total weight.
            float fraction=u.lighting_mode.z==0u ? 1.0-hit.a : 0.0;
            uint half_weight=packHalf2x16(vec2(fraction,0))&65535u;
            fraction=unpackHalf2x16(half_weight).x;
            weights[k/2]|=half_weight<<uint(16*(k&1));
            unresolved=unresolved || fraction>0.0;
            // The diagnostic screen-only path deliberately keeps missing light
            // zero, matching the inline diagnostic instead of inventing a hit.
            float screen_weight=u.lighting_mode.z==0u ? 1.0-fraction : hit.a;
            sum+=vec4(hit.rgb,distance)*screen_weight;
        }
        if(!unresolved) imageStore(u_out,px,reflection_result(r,sum));
    } else if(inside) imageStore(u_out,px,vec4(0,0,0,-1));
    pending[lane]=unresolved ? 1u : 0u;
    barrier();
    // One global append per tile, with a portable workgroup prefix. No optional
    // subgroup-size/wave-operation assumptions and no divergent barriers.
    if(lane==0u) {
        uint count=0u;
        for(uint i=0u;i<64u;++i) {uint n=pending[i];pending[i]=count;count+=n;}
        group_base=count>0u ? atomicAdd(work.job_count,count) : 0u;
        if(count>0u) {
            uint total=group_base+count;
            atomicMax(work.dispatch_x,min((total+63u)/64u,65535u));
            atomicMax(work.dispatch_y,(total+65535u*64u-1u)/(65535u*64u));
        }
    }
    barrier();
    if(unresolved) {
        uint offset=(group_base+pending[lane])*reflection_job_stride();
        work.words[offset]=uint(px.y)*uint(u.screen.x)+uint(px.x);
        for(uint i=0u;i<4u;++i) work.words[offset+1u+i]=floatBitsToUint(sum[i]);
        for(uint i=0u;i<(uint(r.samples)+1u)/2u;++i) work.words[offset+5u+i]=weights[i];
    }
}
#endif
#ifdef REFLECTION_QUEUE_WORLD
void main() {
    uint job=(gl_WorkGroupID.x+gl_WorkGroupID.y*65535u)*64u+gl_LocalInvocationIndex;
    if(job>=work.job_count) return;
    uint offset=job*reflection_job_stride();uint pixel=work.words[offset];
    ivec2 px=ivec2(pixel%uint(u.screen.x),pixel/uint(u.screen.x));
    ReflectionReceiver r;
    if(!reflection_receiver(px,r)) {imageStore(u_out,px,vec4(0,0,0,-1));return;}
    vec4 sum;for(uint i=0u;i<4u;++i) sum[i]=uintBitsToFloat(work.words[offset+1u+i]);
    for(int k=0;k<r.samples;++k) {
        vec2 pair=unpackHalf2x16(work.words[offset+5u+uint(k/2)]);
        float weight=pair[k&1];
        if(weight>0.0) sum+=reflection_world_sample(r,reflection_direction(px,r,k))*weight;
    }
    imageStore(u_out,px,reflection_result(r,sum));
}
#endif
