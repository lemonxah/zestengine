vec3 incoming(vec3 origin, vec3 dir, float eps, float max_dist, uint bounces, inout uint rng, out float first_distance) {
    flux_incoming_prelimited=false;
    first_distance = max_dist;
#if !defined(FLUX_SURFACE_LIGHTING) && !defined(FLUX_RADIANCE_UPDATE) && !defined(FLUX_QUEUE_WORLD)
    if(pc.temporal.w<=2.5) {
        float screen_distance;vec3 screen_radiance;
        // Keep the world fallback's random stream unchanged on a screen miss.
        uint screen_rng=rng;
        if(flux_screen_incoming(origin,dir,max_dist,screen_rng,screen_distance,screen_radiance,true)) {
            if((rc_config.w&2u)!=0u) atomicAdd(rc_work[12],1u);
            first_distance=screen_distance;return screen_radiance;
        }
    }
#endif
    vec3 radiance = vec3(0.0), throughput = vec3(1.0);
    vec3 ro = origin, rd = dir;
    for (uint b = 0u; b < max(bounces, 1u); ++b) {
        vec3 hp;uint who;float trace_max=max_dist;int cache_level=-1;
#if !defined(FLUX_SURFACE_LIGHTING) && !defined(FLUX_RADIANCE_UPDATE)
        if(b==0u && pc.probe_info.y<0.5 && pc.probe_info.w<0.5) {
            cache_level=rc_level(ro,float(hash(rng^0x9e3779b9u))*(1.0/4294967296.0));
            trace_max=rc_local_distance(cache_level,max_dist);
        }
#endif
        mesh_alpha_partial_crossing=false;
        bool found=march(ro,rd,eps,trace_max,hp,who);
        // A ray that is still inside the fat coarse shell re-hits the receiver
        // and then trusts that surface's own cache. Continue past the shell.
        // A field that does not contain the origin (the screen-history fixture's
        // constant far distance) must keep its real near hit.
        if(found) {
            float shell=gdf_surface_offset(ro,eps);
            if(scene_distance(ro)<shell && length(hp-ro)<shell) {
                found=shell<trace_max && march_range(ro,rd,eps,shell,trace_max,hp,who);
            }
        }
#if !defined(FLUX_SURFACE_LIGHTING) && !defined(FLUX_RADIANCE_UPDATE)
        if(!found && trace_max<max_dist) {
            rc_request(ro,cache_level);vec3 far_radiance;float far_distance;
            // A cache probe has its own opacity trials. After this ray has
            // crossed a partial surface, reusing those trials can attenuate
            // the same layer twice. Continue this ray's remaining segment.
            if(!mesh_alpha_partial_crossing && rc_sample(cache_level,ro,rd,max_dist,flux_gather_max_intensity(),float(hash(rng^0x68bc21ebu))*(1.0/4294967296.0),far_radiance,far_distance)) {flux_incoming_prelimited=true;first_distance=max(trace_max,far_distance);return far_radiance;}
            if((rc_config.w&2u)!=0u) atomicAdd(rc_work[4],1u);
            // Continue in the original ray frame. Rebasing would restart the
            // expensive mesh-detail band and change the far-field representation.
            // Software opacity seeds include the layer number within a mesh.
            // Replay from the same origin after a partial crossing so a second
            // layer beyond the split cannot reuse the first layer's trial.
            // A cache miss must not re-accept the receiver shell the first march
            // already discarded. Partial opacity still replays from the origin.
            float resume=mesh_alpha_partial_crossing ? 0.0 : trace_max;
            if(!mesh_alpha_partial_crossing) {
                float shell=gdf_surface_offset(ro,eps);
                if(scene_distance(ro)<shell) resume=max(resume,shell);
            }
            found=march_range(ro,rd,eps,resume,max_dist,hp,who);
        }
#endif
        if (!found) {
#if !defined(FLUX_SURFACE_LIGHTING) && !defined(FLUX_RADIANCE_UPDATE)
            if(b==0u) {
                float distance;vec3 screen_radiance;
                if(flux_screen_incoming(ro,rd,max_dist,rng,distance,screen_radiance,false)) {first_distance=distance;return screen_radiance;}
            }
#endif
            if (pc.probe_info.w > 0.5) return pc.probe_info.w>1.5 ? vec3(0) : vec3(0.0,0.0,1.0);
            radiance += throughput * pc.sky.rgb; break;
        }
        if (b == 0u) first_distance = length(hp - origin);
        vec3 n; bool backface;
        if (!software_material_normal(hp,who,eps,rd,n,backface)) {
            if (pc.probe_info.w > 0.5) return pc.probe_info.w>1.5 ? vec3(0) : vec3(1,1,0);
            break;
        }
        // Diffuse bounce albedo = base·(1−metalness) (albedo.w = metalness, packed
        // by gpu_gi). A metal has no diffuse lobe, so it absorbs the bounce instead
        // of re-radiating it — without this a metal surface pumps light back every
        // bounce and a contact cavity concentrates toward E/(1−albedo). Roughness
        // (emission.w) leaves diffuse magnitude unchanged; it's for the specular GI.
        vec4 material=hit_albedo(who);
        vec3 albedo = material.rgb * (1.0 - clamp(material.w, 0.0, 1.0));
        SurfaceSample surface = (who&MESH_SDF_HIT)!=0u
            ? surface_lookup_mesh(hp,n,0.01,who&~MESH_SDF_HIT)
            : surface_lookup_gdf(hp,n,gdf_surface_offset(hp,eps),who);
        // An SDF hit still blocks when approached from behind. Only an actual
        // back-facing material capture (two-sided material) may shade that side;
        // the mesh's average emission must not turn a missing back face into a
        // second emitter. Preserve energy accumulated at earlier bounces.
        if (backface && !surface.valid) {
            if (pc.probe_info.w > 0.5) return pc.probe_info.w>1.5 ? vec3(0) : vec3(1,1,0);
            break;
        }
#ifdef FLUX_RADIANCE_UPDATE
        if(!surface.valid) flux_world_source_valid=false;
#endif
#if !defined(FLUX_SURFACE_LIGHTING) && !defined(FLUX_RADIANCE_UPDATE)
        // Reuse the already source-mapped world result. Established material
        // cards retain their view-independent transport; only gaps need HDR.
        if(b==0u && !surface.valid) {
            float distance;vec3 screen_radiance;
            if(flux_screen_incoming(ro,rd,min(max_dist,first_distance+eps),rng,distance,screen_radiance,false)) {first_distance=distance;return screen_radiance;}
        }
#endif
        if (surface.valid) {
            albedo = surface.albedo * (1.0-surface.metallic);
            n = surface.normal;
        }
        // Mixed lighting excludes baked STATIC emission, not moving emitters.
        bool live_emission=pc.probe_info.y<0.5 || (surface.valid && !surface.static_geometry);
        vec3 emission=live_emission && !on_emitter(hp)
            ? (surface.valid ? surface.emission : hit_emission(who))*pc.transport.x : vec3(0.0);
        bool surface_lit;
        vec3 lit_surface = surface_radiance(surface,surface_lit);
        if (pc.probe_info.w > 1.5) return surface_lit ? vec3(0,1,0) : surface.valid ? vec3(0,0,1) : vec3(1,0,0);
        if (pc.probe_info.w > 0.5) return surface_lit ? vec3(0.0,1.0,0.0) : vec3(1.0,0.0,0.0);
        if (surface_lit && pc.probe_info.y < 0.5) { radiance += throughput * (lit_surface + emission); break; }
        // Optional world-probe irradiance lookup, not a surface cache. Mixed
        // lighting skips this volume because its static light is already baked.
        float cov;
        vec3 cached_irr = cache_irradiance(hp, n, cov);
        if (cov > 0.0 && pc.probe_info.y < 0.5) {
            // Near-field occlusion: a hit only a voxel or two away is contact
            // occlusion, not a bright bouncer; fade the contribution in over a
            // few voxels of ray travel so light doesn't pool right under meshes.
            float hit_dist = length(hp - ro);
            vec3 cell = flux_field_cell(flux_field_level(hp));
            float vox = max(cell.x, max(cell.y, cell.z));
            float occ = smoothstep(vox * 1.5, vox * 6.0, hit_dist);
            radiance += throughput * (emission + albedo * cached_irr * occ);
            break;
        }
        // Without world-probe coverage, shade and continue a finite path.
        // Only physical radiance is propagated; screen intensity/history must
        // never feed back into transport as an extra source of bounce energy.
        radiance += throughput * (emission + (albedo / PI) * (direct_light(hp, n, eps, rng) + emitter_light(hp, n, eps)));
        throughput *= albedo;
        if (max(max(throughput.r, throughput.g), throughput.b) < 0.01) break;
        ro = hp + n * software_surface_offset(hp,eps);
        rd = cosine_hemisphere(n, rng);
    }
    return radiance;
}

// World position from a depth sample at screen UV (Vulkan depth 0..1).
vec3 world_from_depth(vec2 uv, float depth) {
    vec2 ndc = uv * 2.0 - 1.0;
    if (pc.misc.w != 0u) ndc.y = -ndc.y; // negative-height viewport flip
    vec4 clip = vec4(ndc, depth, 1.0);
    vec4 w = pc.inv_view_proj * clip;
    return w.xyz / w.w;
}

#include "flux_temporal.glsl"
