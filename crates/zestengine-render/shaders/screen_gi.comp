#include "flux_radiance_update.glsl"
#elif defined(FLUX_SURFACE_LIGHTING)
#include "flux_surface_light.glsl"
#elif defined(FLUX_QUEUE_WORLD)
// Entry point comes from flux_trace_queue.glsl.
#elif defined(FLUX_RECEIVER_SETUP) || defined(FLUX_DIRECTIONAL_TRACE) || defined(FLUX_ADAPTIVE_PLACEMENT) || defined(FLUX_ADAPTIVE_RESOLVE)
#include "flux_gather_software.glsl"
#else
void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    uint sw = pc.misc.y, sh = pc.misc.z;
    if (px.x >= sw || px.y >= sh) return;
    uint pidx = px.y * sw + px.x;
    // Probe on a real surface texel of its tile (see flux_probe_surface).
    vec3 p, n;
    if (!flux_probe_surface(u_depth, px, uvec2(sw, sh), pc.inv_view_proj, pc.misc.w != 0u, p, n)) {
        // Sky: zero the SH too, or the integrate reads this slot's stale SH.
        imageStore(u_out, ivec2(px), vec4(0.0));
        sh_out[pidx].c[0] = vec4(0.0); sh_out[pidx].c[1] = vec4(0.0);
        sh_out[pidx].c[2] = vec4(0.0); sh_out[pidx].c[3] = vec4(0.0);
        sh_out[pidx].c[4] = vec4(0.0);
        return;
    }
    if (dot(n, pc.cam.xyz - p) < 0.0) n = -n; // face the camera
    float cam_dist = length(p - pc.cam.xyz);

    float eps = pc.march.x, max_dist = pc.march.y;
    // Quality controls samples per directional cell. At least one sample in
    // every cell avoids holes in the radiance distribution on the first frame.
    uint per_cell = clamp((pc.counts.x + 15u) / 16u, 1u, 16u);
    uint rng = hash(px.x * 1973u + px.y * 9277u + pc.misc.x * 26699u);
    vec3 origin = p + n * max(software_surface_offset(p,eps), flux_probe_offset(p));
    float fclamp = flux_gather_max_intensity();
    // Stream one direction at a time to keep ray-query register pressure low.
    FluxHistory history = flux_history(p, n, uvec2(sw, sh));
    float min_alpha = flux_probe_alpha(p);
    vec3 irr = vec3(0.0);
    uint backs = 0u;
    for (uint bin = 0u; bin < FLUX_DIRECTION_COUNT; ++bin) {
        vec3 radiance = vec3(0.0);
        float distance = 0.0;
        for (uint i = 0u; i < per_cell; ++i) {
            vec2 jitter = vec2((float(i) + rnd(rng)) / float(per_cell), rnd(rng));
            vec3 d = cosine_hemisphere_dir(n, flux_direction_uv(bin, jitter));
            float hit_distance;
            radiance += flux_limit_gather(incoming(origin, d, eps, max_dist, pc.counts.y, rng, hit_distance), fclamp);
            distance += min(hit_distance, 65504.0);
        }
        FluxRay ray;
        ray.radiance = radiance * (pc.sky.w / float(per_cell));
        ray.state = flux_ray_state(distance / float(per_cell), 1.0);
        ray = flux_accumulate_direction(history, bin, ray, min_alpha);
        sh_out[pidx].rays[bin] = ray;
        irr += ray.radiance / float(FLUX_DIRECTION_COUNT);
    }
    bool probe_ok = true;
    float out_dist = probe_ok ? cam_dist : 0.0;
    sh_out[pidx].c[0] = vec4(0.0, 0.0, 0.0, out_dist);
    sh_out[pidx].c[1] = vec4(0.0, 0.0, 0.0, n.x);
    sh_out[pidx].c[2] = vec4(0.0, 0.0, 0.0, n.y);
    sh_out[pidx].c[3] = vec4(0.0, 0.0, 0.0, n.z);
    sh_out[pidx].c[4] = vec4(0.0, p);
    imageStore(u_out, ivec2(px), vec4(irr, out_dist));
}

#endif
