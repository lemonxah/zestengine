#version 460
// FluxRT screen-probe gather. Trace the scene TLAS and retain 16 directional
// radiance cells, primary hit distances and valid history counts per probe.
// flux_denoise filters these cells before SH conversion and full-resolution
// integration. The optional world-probe volume is an irradiance fallback;
// it is not a surface-material/lighting cache.

#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

