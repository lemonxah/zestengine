#version 460
// Moving water for the ray-traced reflections: each vertex of a water mesh
// displaced by its body's Gerstner sum + ripple height exactly as standard.vert
// does (band-limited to the grid spacing at the vertex), written as a packed
// position for the water BLAS refit (rt_water.rs).

#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 64) in;

// Engine Vertex (104 bytes = 26 floats): pos 0-2, colour 8-11, uv1 16-17.
const uint VERTEX_FLOATS = 26u;
layout(buffer_reference, std430) readonly buffer Vertices { float f[]; };
layout(buffer_reference, std430) writeonly buffer Positions { float p[]; };

// Mirrors GpuWater (types.rs / standard_common.glsl).
#include "water_types.glsl"

layout(set = 0, binding = 0, std140) readonly buffer WaterData {
    vec4 water; // x water clock
    GpuWater bodies[MAX_WATER_BODIES];
    vec4 coverage[];
} u;
// Each body's ripple field (r height); only bound for bodies that have one.
layout(set = 0, binding = 1) uniform sampler2D u_ripple[MAX_WATER_BODIES];
// Each body's baked shore depth (r metres over local XZ); only bound for
// bodies that have one (`extra.yz` carries the calm depth + half extent).
layout(set = 0, binding = 2) uniform sampler2D u_shore[MAX_WATER_BODIES];

layout(push_constant) uniform Push {
    uint64_t src;
    uint64_t dst;
    uint count;
    uint slot;
    uint ripple; // 1 = u_ripple[slot] is bound
    // The mesh's origin in the body's local XZ (an ocean grid drawn shifted).
    float offset_x;
    float offset_z;
} pc;

#define WATER_OCEAN_DATA u.coverage
#include "water_waves.glsl"
#define WATER_BODY_DATA u.bodies
#define WATER_COVERAGE_DATA u.coverage
#include "water_connections.glsl"

// standard.vert's water_shore: share of the waves left at local `xz` (0..1),
// calm over water shallower than the body's shore depth.
float water_shore(int slot, vec2 xz) {
    vec4 e = u.bodies[slot].extra;
    if (e.y <= 0.0 || e.z <= 0.0) {
        return 1.0;
    }
    vec2 uv = xz / (2.0 * e.zw) + 0.5;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) {
        return 1.0;
    }
    return smoothstep(0.0, e.y, textureLod(u_shore[nonuniformEXT(slot)], uv, 0.0).r);
}

#include "water_vertex_column.glsl"
vec3 water_vertex_sample(int slot,vec2 xz,float spacing,float rest_y,float edge){
    vec3 d,n;float crest,lost;
    water_connected_waves(u.bodies[slot],xz,u.water.x,spacing,d,n,crest,lost);
    d*=water_connected_shore(u.bodies[slot],xz,water_shore(slot,xz));
    vec4 r=u.bodies[slot].ripple;
    if(pc.ripple!=0u&&r.z>0.0){vec2 uv=(xz-r.xy)/r.z+0.5,e=min(uv,1.0-uv);
        float fade=smoothstep(0.0,0.08,min(e.x,e.y));
        if(fade>0.0){float size=float(textureSize(u_ripple[nonuniformEXT(slot)],0).x);
            float lod=max(log2(spacing*size/r.z)+0.75,0.0);d.y+=textureLod(u_ripple[nonuniformEXT(slot)],uv,lod).r*fade;}}
    edge=water_connected_edge(u.bodies[slot],xz,clamp(edge,0.0,1.0));d.y*=1.0-edge*edge;
    return vec3(xz.x,rest_y,xz.y)+d;
}
#include "water_lod.glsl"

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    Vertices src = Vertices(pc.src);
    uint o = i * VERTEX_FLOATS;
    vec3 rest = vec3(src.f[o], src.f[o + 1], src.f[o + 2]);
    float edge = src.f[o + 10];
    float spacing = max(src.f[o + 16], 1e-3);
    int slot = int(pc.slot);
    vec2 xz = rest.xz + vec2(pc.offset_x, pc.offset_z);

    vec3 d, nrm;float crest,lost;
    water_connected_waves(u.bodies[slot],xz,u.water.x,spacing,d,nrm,crest,lost);
    // The Gerstner waves calm over the shallows near a shore (the raster's
    // `d *= shoal` in standard.vert; the ripple layer is added after, as there).
    d *= water_connected_shore(u.bodies[slot],xz,water_shore(slot,xz));
    vec4 r = u.bodies[slot].ripple;
    if (pc.ripple != 0u && r.z > 0.0) {
        vec2 ruv = (xz - r.xy) / r.z + 0.5;
        vec2 e = min(ruv, 1.0 - ruv);
        float fade = smoothstep(0.0, 0.08, min(e.x, e.y));
        if (fade > 0.0) {
            // standard_common.glsl's water_ripple_lod.
            float size = float(textureSize(u_ripple[nonuniformEXT(slot)], 0).x);
            float lod = max(log2(spacing * size / r.z) + 0.75, 0.0);
            d.y += textureLod(u_ripple[nonuniformEXT(slot)], ruv, lod).r * fade;
        }
    }
    edge=water_connected_edge(u.bodies[slot],xz,edge);
    d.y *= 1.0 - edge * edge;
    vec3 p = water_lod_position(slot,xz,spacing,src.f[o+17],vec3(xz.x,rest.y,xz.y)+d)-vec3(pc.offset_x,0.0,pc.offset_z);
    Positions dst = Positions(pc.dst);
    dst.p[i * 3u] = p.x;
    dst.p[i * 3u + 1u] = p.y;
    dst.p[i * 3u + 2u] = p.z;
}
