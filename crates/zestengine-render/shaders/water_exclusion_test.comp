#version 450
#include "water_types.glsl"
layout(local_size_x = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer Scene { GpuWater bodies[MAX_WATER_BODIES]; vec4 coverage[]; } scene;
layout(std430, set = 0, binding = 1) readonly buffer Queries { vec4 data[]; } queries;
layout(std430, set = 0, binding = 2) writeonly buffer Results { vec4 data[]; } results;
#define WATER_COVERAGE_DATA scene.coverage
#include "water_coverage.glsl"
#include "water_exclusions.glsl"
#include "water_path.glsl"
#define WATER_BODY_DATA scene.bodies
#define WATER_OCEAN_DATA scene.coverage
#include "water_waves.glsl"
#include "water_connections.glsl"
#include "water_media.glsl"
void main() {
    uint i = gl_GlobalInvocationID.x;
    vec4 p = queries.data[i*3u], d = queries.data[i*3u+1u], range = queries.data[i*3u+2u];
    if(range.z>0.5){vec3 trans,scatter;float wet;water_media_trace(p.xyz,d.xyz,range.xy,false,trans,scatter,wet);results.data[i]=vec4(range.z>1.5?scatter:trans,wet);return;}
    GpuWater body = scene.bodies[uint(p.w)];
    results.data[i] = vec4(water_excluded(body, p.xyz) ? 1.0 : 0.0,
        water_dry_distance(body, p.xyz, d.xyz, range.xy), water_medium_distance(body, p.xyz, d.xyz, range.xy), 0.0);
}
